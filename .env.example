# NameVerse Environment Configuration

# Site URL (used for canonical URLs, OG tags, sitemaps)
NEXT_PUBLIC_SITE_URL=https://nameverse.site

# Backend API URL
NEXT_PUBLIC_API_BASE=https://name-meaning-site-backend.vercel.app

# Webhook secret for on-demand cache revalidation
# Set this to a strong random string in production
# Backend should send: Authorization: Bearer REVALIDATE_WEBHOOK_SECRET
REVALIDATE_WEBHOOK_SECRET=
